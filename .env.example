# Storage
DB_PATH=data_store/crypto_signal.db
LOG_DIR=logs

# Watchlist / scanning
QUOTE_ASSET=USDT
WATCHLIST_SIZE=15
TIMEFRAMES=5m,15m,1h,4h,1d,1w

# Risk defaults (editable later from the Settings page)
DEFAULT_PORTFOLIO_SIZE=1000
DEFAULT_MAX_RISK_PCT=1.0
ATR_STOP_MULTIPLE=1.5

# Learning
ML_TRAINING_THRESHOLD=300
OUTCOME_LOOKFORWARD_CANDLES=30

# Telegram bot (required only for telegram_bot/bot.py and jobs/live_scanner.py alerts)
TELEGRAM_BOT_TOKEN=
